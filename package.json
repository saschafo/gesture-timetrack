{
  "name": "gesture-timetrack",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "description": "Zeiterfassung per Handgeste - 100 % offline, ohne Hardware-Buzzer",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/fetch-assets.mjs",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "assets": "node scripts/fetch-assets.mjs",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "version:set": "node scripts/set-version.mjs",
    "repo:set": "node scripts/set-repo.mjs",
    "shot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^5.9.2",
    "vite": "^8.2.1",
    "vue-tsc": "^3.3.10"
  }
